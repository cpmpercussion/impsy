{
  "spec_version": "0.1.0",
  "description": "MIDI bytes in -> the input vector indices it sets and their value, or null if ignored. Indices are 0-based over x_1..x_n (dt excluded).",
  "tolerance": 1e-09,
  "cases": [
    {
      "name": "note_on_value_is_pitch",
      "description": "A note-on on a mapped channel sets that dimension to note/127. Velocity is ignored.",
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 42],
        ["note_on", 2],
        ["control_change", 16, 7]
      ],
      "messages": [
        [144, 60, 100],
        [144, 60, 1],
        [144, 0, 127],
        [144, 127, 127],
        [145, 64, 90]
      ],
      "expected": [
        {
          "indices": [0],
          "value": 0.47244094488188976
        },
        {
          "indices": [0],
          "value": 0.47244094488188976
        },
        {
          "indices": [0],
          "value": 0.0
        },
        {
          "indices": [0],
          "value": 1.0
        },
        {
          "indices": [2],
          "value": 0.5039370078740157
        }
      ]
    },
    {
      "name": "note_on_velocity_zero",
      "description": "A note-on with velocity 0 is a note-off by MIDI convention, so it's ignored like other note-offs.",
      "issues": ["https://github.com/cpmpercussion/impsy/issues/99"],
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 42],
        ["note_on", 2],
        ["control_change", 16, 7]
      ],
      "messages": [
        [144, 60, 0],
        [145, 72, 0]
      ],
      "expected": [null, null]
    },
    {
      "name": "note_off_ignored",
      "description": "Note-off messages never change the input vector.",
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 42],
        ["note_on", 2],
        ["control_change", 16, 7]
      ],
      "messages": [
        [128, 60, 0],
        [129, 64, 64]
      ],
      "expected": [null, null]
    },
    {
      "name": "control_change_value",
      "description": "A CC on a mapped channel and controller sets that dimension to value/127.",
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 42],
        ["note_on", 2],
        ["control_change", 16, 7]
      ],
      "messages": [
        [176, 42, 0],
        [176, 42, 64],
        [176, 42, 127],
        [191, 7, 100]
      ],
      "expected": [
        {
          "indices": [1],
          "value": 0.0
        },
        {
          "indices": [1],
          "value": 0.5039370078740157
        },
        {
          "indices": [1],
          "value": 1.0
        },
        {
          "indices": [3],
          "value": 0.7874015748031497
        }
      ]
    },
    {
      "name": "unmapped_messages_ignored",
      "description": "Messages on unmapped channels or controllers, and unsupported message types, are ignored.",
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 42],
        ["note_on", 2],
        ["control_change", 16, 7]
      ],
      "messages": [
        [146, 60, 100],
        [176, 43, 64],
        [177, 42, 64],
        [224, 0, 64],
        [248]
      ],
      "expected": [null, null, null, null, null]
    },
    {
      "name": "channels_are_one_based_in_config",
      "description": "Config channel 1 is status nibble 0; config channel 16 is status nibble 15.",
      "dimension": 3,
      "input_mapping": [
        ["note_on", 16],
        ["control_change", 1, 1]
      ],
      "messages": [
        [159, 60, 100],
        [144, 60, 100],
        [176, 1, 50],
        [191, 1, 50]
      ],
      "expected": [
        {
          "indices": [0],
          "value": 0.47244094488188976
        },
        null,
        {
          "indices": [1],
          "value": 0.3937007874015748
        },
        null
      ]
    },
    {
      "name": "duplicate_mapping_sets_every_dimension",
      "description": "A message mapped to several dimensions sets all of them to the same value.",
      "issues": ["https://github.com/cpmpercussion/impsy/issues/102"],
      "dimension": 5,
      "input_mapping": [
        ["note_on", 1],
        ["control_change", 1, 7],
        ["note_on", 1],
        ["control_change", 1, 7]
      ],
      "messages": [
        [144, 60, 100],
        [176, 7, 32]
      ],
      "expected": [
        {
          "indices": [0, 2],
          "value": 0.47244094488188976
        },
        {
          "indices": [1, 3],
          "value": 0.25196850393700787
        }
      ]
    }
  ]
}
